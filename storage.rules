rules_version = '2';

// Firebase Storage Security Rules for Smart Waste Segregation System
// Bucket: gs://garbage-fa1b3.firebasestorage.app
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write to captures directory for ESP32-CAM and web dashboard
    match /captures/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Default fallback rule
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
